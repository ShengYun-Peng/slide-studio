{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slide Studio storyboard",
  "type": "object",
  "required": [
    "slides"
  ],
  "properties": {
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "layout",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,79}$"
          },
          "layout": {
            "enum": [
              "title",
              "question",
              "bullets",
              "takeaway",
              "comparison",
              "roadmap",
              "paper-cover",
              "impact",
              "acknowledgements",
              "scene"
            ]
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "body": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "claim_type": {
            "enum": [
              "measured",
              "illustrative",
              "reconstructed",
              "proposed",
              "editorial"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                },
                "claim": {
                  "type": "string"
                }
              }
            }
          },
          "scene": {
            "type": "object",
            "required": [
              "template"
            ],
            "properties": {
              "template": {
                "type": "string"
              },
              "overrides": {
                "type": "object"
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
